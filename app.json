{
  "expo": {
    "name": "Tripzo",
    "slug": "tripzo",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tripzo",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101B35"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kalaburagitech.tripzo"
    },
    "android": {
      "package": "com.kalaburagitech.tripzo",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#101B35"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a0b542f5-60e3-4e00-a6b8-7a6c9b568a80"
      }
    },
    "owner": "kalaburagitech"
  }
}
